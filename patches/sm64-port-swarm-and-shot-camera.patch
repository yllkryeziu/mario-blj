diff --git a/src/game/warp_band.c b/src/game/warp_band.c
new file mode 100644
index 0000000..06bed2f
--- /dev/null
+++ b/src/game/warp_band.c
@@ -0,0 +1,280 @@
+/**
+ * Paints the endless staircase's instant warp floors red, so the trap is visible in a render.
+ *
+ * The task the policies in this project learn is to escape the endless staircase, and the thing
+ * that makes it a trap is invisible. Walking up the stairs past a certain depth puts Mario on a
+ * floor whose surface type is SURFACE_INSTANT_WARP_1B, and check_instant_warp then displaces him
+ * by the area's instant warp vector once per frame, which in the castle is (0, -205, +410): down
+ * one flight and back to the bottom. On screen nothing happens at all. Mario walks up a staircase
+ * and stays where he is, and a viewer who does not already know the trick sees a treadmill with no
+ * mechanism.
+ *
+ * This file draws the mechanism. It does not draw a hand placed marker at a z range copied out of
+ * a level script -- it walks the surfaces the collision loader actually built, keeps every one
+ * whose type is in the instant warp range, and emits those exact triangles. In the castle that is
+ * twelve triangles making three steps: six treads and the six risers under them. check_instant_warp
+ * reads the floor Mario is standing on, so it is the treads that fire; the risers are typed the
+ * same way by the level and are painted with them because they are the face of those steps a camera
+ * standing below the flight can actually see. Nothing red is outside the level's own marking, and
+ * no marked triangle is left unpainted.
+ *
+ * Each triangle is offset a few units along its own normal and drawn in the transparent layer
+ * rather than decalled onto the surface, because collision geometry in this game is its own mesh
+ * and is not guaranteed coplanar with the visible geometry over it. Offsetting along the normal
+ * rather than along y keeps a riser standing where it is instead of sliding it up its own step. A
+ * few units on a Mario who is 160 units tall reads as paint; a decal that loses the depth fight
+ * reads as nothing.
+ */
+
+#include <PR/ultratypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "sm64.h"
+#include "area.h"
+#include "engine/geo_layout.h"
+#include "engine/graph_node.h"
+#include "engine/surface_load.h"
+#include "game_init.h"
+#include "surface_terrains.h"
+#include "warp_band.h"
+
+/** Room for the largest instant warp floor set in the game, with the castle's at 12 triangles. */
+#define WARP_BAND_MAX_TRIS 64
+/** Offset along the surface normal, enough to clear visible geometry sitting over the collision. */
+#define WARP_BAND_LIFT 6.0f
+// Cyan rather than the obvious red, because the endless staircase is carpeted in red and a red
+// band on it is invisible. The alpha is high enough to hold its colour over the carpet and low
+// enough that the step edges under it still read. SM64_WARP_BAND may carry "r,g,b,a" to override.
+#define WARP_BAND_R 40
+#define WARP_BAND_G 225
+#define WARP_BAND_B 255
+#define WARP_BAND_A 190
+
+// The vertex cache holds 32 entries, so triangles are emitted in batches of ten and their three
+// vertices are written out per triangle rather than shared. Sharing would save a third of the
+// vertices and cost the guarantee that each drawn triangle is exactly one collision triangle.
+#define WARP_BAND_BATCH 10
+
+static struct GraphNodeGenerated sWarpBandNode;
+static Vtx sWarpBandVerts[WARP_BAND_MAX_TRIS * 3];
+static Gfx sWarpBandList[WARP_BAND_MAX_TRIS / WARP_BAND_BATCH * 2 + WARP_BAND_MAX_TRIS + 8];
+static struct Surface *sWarpBandSurfaces[WARP_BAND_MAX_TRIS];
+static s32 sWarpBandTris = 0;
+static s32 sWarpBandChecked = FALSE;
+static s32 sWarpBandEnabled = FALSE;
+static s32 sWarpBandSaidEmpty = FALSE;
+static u8 sWarpBandColor[4] = { WARP_BAND_R, WARP_BAND_G, WARP_BAND_B, WARP_BAND_A };
+static s16 sWarpBandLevel = -1;
+static s16 sWarpBandArea = -1;
+
+/**
+ * Whether a surface type is one check_instant_warp acts on.
+ *
+ * Args:
+ *     type: A struct Surface's type field.
+ *
+ * Returns:
+ *     TRUE for the four instant warp types.
+ */
+static s32 warp_band_is_trap(s16 type) {
+    return type >= SURFACE_INSTANT_WARP_1B && type <= SURFACE_INSTANT_WARP_1E;
+}
+
+/**
+ * Adds one collision triangle to the band, ignoring a surface already collected.
+ *
+ * Args:
+ *     surface: A floor whose type warp_band_is_trap accepted.
+ */
+static void warp_band_add(struct Surface *surface) {
+    Vtx *vtx = &sWarpBandVerts[sWarpBandTris * 3];
+    s16 *source[3];
+    s32 i;
+
+    for (i = 0; i < sWarpBandTris; i++) {
+        if (sWarpBandSurfaces[i] == surface) {
+            return;
+        }
+    }
+    if (sWarpBandTris >= WARP_BAND_MAX_TRIS) {
+        return;
+    }
+    source[0] = surface->vertex1;
+    source[1] = surface->vertex2;
+    source[2] = surface->vertex3;
+    for (i = 0; i < 3; i++) {
+        vtx[i].v.ob[0] = source[i][0] + (s16) (surface->normal.x * WARP_BAND_LIFT);
+        vtx[i].v.ob[1] = source[i][1] + (s16) (surface->normal.y * WARP_BAND_LIFT);
+        vtx[i].v.ob[2] = source[i][2] + (s16) (surface->normal.z * WARP_BAND_LIFT);
+    }
+    for (i = 0; i < 3; i++) {
+        vtx[i].v.flag = 0;
+        vtx[i].v.tc[0] = 0;
+        vtx[i].v.tc[1] = 0;
+        vtx[i].v.cn[0] = sWarpBandColor[0];
+        vtx[i].v.cn[1] = sWarpBandColor[1];
+        vtx[i].v.cn[2] = sWarpBandColor[2];
+        vtx[i].v.cn[3] = sWarpBandColor[3];
+    }
+    sWarpBandSurfaces[sWarpBandTris++] = surface;
+}
+
+/**
+ * Collects the loaded instant warp triangles and assembles their display list.
+ *
+ * Called once per loaded area, on the first frame after its collision is in. Within an area the
+ * whole list is static because the geometry is: these are static surfaces, so nothing about them
+ * changes and rebuilding per frame would only cost time.
+ */
+static void warp_band_build(void) {
+    Gfx *head = sWarpBandList;
+    s32 cellX;
+    s32 cellZ;
+    s32 list;
+    s32 i;
+    s32 batch;
+    s32 emitted;
+
+    // This build allocates surfaces out of a pool that cannot be indexed, so the collected set
+    // comes from the collision partition instead. All three lists are walked, because the loader
+    // files a surface by its normal and an instant warp step contributes a tread to the floors and
+    // a riser to the walls. A surface spanning a cell boundary is filed in every cell it touches,
+    // hence the dedup by address in warp_band_add.
+    for (cellZ = 0; cellZ < NUM_CELLS; cellZ++) {
+        for (cellX = 0; cellX < NUM_CELLS; cellX++) {
+            for (list = 0; list < 3; list++) {
+                struct SurfaceNode *node = gStaticSurfacePartition[cellZ][cellX][list].next;
+
+                for (; node != NULL; node = node->next) {
+                    if (warp_band_is_trap(node->surface->type)) {
+                        warp_band_add(node->surface);
+                    }
+                }
+            }
+        }
+    }
+    if (sWarpBandTris == 0) {
+        if (!sWarpBandSaidEmpty) {
+            sWarpBandSaidEmpty = TRUE;
+            fprintf(stderr, "warp band: level %d area %d has no instant warp floors\n",
+                    gCurrLevelNum, gCurrAreaIndex);
+        }
+        return;
+    }
+
+    // Vertex colours reach the framebuffer only with lighting off and the shade-only combiner, and
+    // back face culling off keeps the band visible from a camera set below the staircase.
+    gDPPipeSync(head++);
+    gSPClearGeometryMode(head++, G_LIGHTING | G_CULL_BACK);
+    gDPSetCombineMode(head++, G_CC_SHADE, G_CC_SHADE);
+    gSPTexture(head++, 0xFFFF, 0xFFFF, 0, G_TX_RENDERTILE, G_OFF);
+    for (emitted = 0; emitted < sWarpBandTris; emitted += batch) {
+        batch = sWarpBandTris - emitted;
+        if (batch > WARP_BAND_BATCH) {
+            batch = WARP_BAND_BATCH;
+        }
+        gSPVertex(head++, &sWarpBandVerts[emitted * 3], batch * 3, 0);
+        for (i = 0; i < batch; i++) {
+            gSP1Triangle(head++, i * 3, i * 3 + 1, i * 3 + 2, 0);
+        }
+    }
+    gDPPipeSync(head++);
+    gSPSetGeometryMode(head++, G_LIGHTING | G_CULL_BACK);
+    gSPEndDisplayList(head);
+    fprintf(stderr, "warp band: %d instant warp triangles painted in level %d area %d\n",
+            sWarpBandTris, gCurrLevelNum, gCurrAreaIndex);
+}
+
+/**
+ * Graph node callback that hands the assembled band to the renderer.
+ *
+ * Args:
+ *     callContext: The geo layout call context; only GEO_CONTEXT_RENDER draws.
+ *     node: Unused; the band's geometry is in world space and needs no node state.
+ *     context: Unused matrix pointer.
+ *
+ * Returns:
+ *     The band's display list, or NULL when there is nothing to draw.
+ */
+static Gfx *warp_band_geo(s32 callContext, UNUSED struct GraphNode *node, UNUSED void *context) {
+    if (callContext != GEO_CONTEXT_RENDER || sWarpBandTris == 0) {
+        return NULL;
+    }
+    return sWarpBandList;
+}
+
+/**
+ * Puts the band's node on the object parent, taking it out of that list first if it is still in it.
+ *
+ * Remounting is needed because the band is rebuilt per area, and the two ways an area can change
+ * differ in what they leave behind. A level load reinitialises gObjParentGraphNode and drops every
+ * child without telling the children, which leaves this node holding sibling pointers into a list
+ * nobody walks any more, so unlinking through them would corrupt whatever occupies the list now.
+ * change_area leaves the list alone, so the node is still in it and adding it again would splice it
+ * into its own list twice. Walking the parent's children and unlinking only when the node is
+ * actually found there covers both cases without having to guess which one happened.
+ */
+static void warp_band_mount(void) {
+    struct GraphNode *node = &sWarpBandNode.fnNode.node;
+    struct GraphNode *child = gObjParentGraphNode.children;
+
+    if (child != NULL) {
+        do {
+            if (child == node) {
+                geo_remove_child(node);
+                break;
+            }
+            child = child->next;
+        } while (child != gObjParentGraphNode.children);
+    }
+    init_graph_node_generated(NULL, &sWarpBandNode, warp_band_geo, 0);
+    // The high bits of the flags carry the layer geo_append_display_list files the list under.
+    // Layer 5 is the z-buffered transparent pass, which is what a lifted translucent overlay wants.
+    sWarpBandNode.fnNode.node.flags = (sWarpBandNode.fnNode.node.flags & 0xFF) | (5 << 8);
+    geo_add_child(&gObjParentGraphNode, node);
+}
+
+/**
+ * Rebuilds and mounts the band whenever the loaded area changes.
+ *
+ * Called from Mario's update, which is late enough that collision is loaded. Keying on the area
+ * rather than building once is what makes the band describe the room on screen: the movie that
+ * walks the game to the staircase passes through several other areas first, two of which have
+ * instant warp floors of their own, and a band built on the first frame Mario exists would be the
+ * wrong room's, or empty.
+ *
+ * The node goes on the object parent, which is under the area's own root transform, so the
+ * triangles are drawn in the world coordinates the collision loader stored them in with no matrix
+ * work of their own.
+ */
+void warp_band_update(void) {
+    if (!sWarpBandChecked) {
+        const char *setting = getenv("SM64_WARP_BAND");
+        s32 rgba[4];
+
+        sWarpBandChecked = TRUE;
+        sWarpBandEnabled = setting != NULL;
+        if (setting != NULL
+            && sscanf(setting, "%d,%d,%d,%d", &rgba[0], &rgba[1], &rgba[2], &rgba[3]) == 4) {
+            s32 channel;
+
+            for (channel = 0; channel < 4; channel++) {
+                sWarpBandColor[channel] = (u8) (rgba[channel] < 0 ? 0
+                                                : rgba[channel] > 255 ? 255 : rgba[channel]);
+            }
+        }
+    }
+    if (!sWarpBandEnabled
+        || (gCurrLevelNum == sWarpBandLevel && gCurrAreaIndex == sWarpBandArea)) {
+        return;
+    }
+    sWarpBandLevel = gCurrLevelNum;
+    sWarpBandArea = gCurrAreaIndex;
+    sWarpBandTris = 0;
+    warp_band_build();
+    if (sWarpBandTris == 0) {
+        return;
+    }
+    warp_band_mount();
+}
