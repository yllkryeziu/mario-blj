     outState->invincTimer = gMarioState->invincTimer;
 }
 
+SM64_LIB_FN void sm64_mario_extra_state( int32_t marioId, struct SM64MarioExtraState *outState )
+{
+    if( marioId >= s_mario_instance_pool.size || s_mario_instance_pool.objects[marioId] == NULL )
+    {
+        DEBUG_PRINT("Tried to read non-existant Mario with ID: %u", marioId);
+        return;
+    }
+
+    global_state_bind( ((struct MarioInstance *)s_mario_instance_pool.objects[ marioId ])->globalState );
+
+    struct SM64SurfaceCollisionData *floor = gMarioState->floor;
+    outState->hasFloor = floor != NULL;
+    outState->floorType = floor != NULL ? floor->type : -1;
+    outState->floorTerrain = floor != NULL ? floor->terrain : -1;
+    outState->floorNormalY = floor != NULL ? floor->normal.y : 0.0f;
+    outState->hasWall = gMarioState->wall != NULL;
+    outState->floorHeight = gMarioState->floorHeight;
+    outState->ceilHeight = gMarioState->ceilHeight;
+    outState->peakHeight = gMarioState->peakHeight;
+    outState->slideVelX = gMarioState->slideVelX;
+    outState->slideVelZ = gMarioState->slideVelZ;
+    outState->intendedMag = gMarioState->intendedMag;
+    outState->intendedYaw = gMarioState->intendedYaw;
+    outState->input = gMarioState->input;
+    outState->action = gMarioState->action;
+    outState->prevAction = gMarioState->prevAction;
+    outState->actionState = gMarioState->actionState;
+    outState->actionTimer = gMarioState->actionTimer;
+    outState->actionArg = gMarioState->actionArg;
+    outState->hurtCounter = gMarioState->hurtCounter;
+    outState->squishTimer = gMarioState->squishTimer;
+
+    struct GraphNodeObject *gfx = &gMarioState->marioObj->header.gfx;
+    for( int i = 0; i < 3; ++i )
+    {
+        outState->gfxPosition[i] = gfx->pos[i];
+        outState->gfxAngle[i] = gfx->angle[i];
+        outState->torsoAngle[i] = gMarioState->marioBodyState->torsoAngle[i];
+    }
+    outState->faceAnglePitch = gMarioState->faceAngle[0];
+    outState->faceAngleRoll = gMarioState->faceAngle[2];
+}
