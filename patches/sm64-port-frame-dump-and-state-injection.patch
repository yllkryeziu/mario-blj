+/**
+ * A recorded state trajectory, stamped over Mario after physics has run.
+ *
+ * The reinforcement learning project this build serves drives libsm64, which hands back geometry
+ * rather than pixels, so an episode can be measured exactly but never screenshotted. This build is
+ * the same decompilation with the real renderer attached, and its Mario is driven by a controller
+ * rather than by a policy. Overwriting gMarioState from a file bridges the two: the recorded
+ * episode is drawn with the game's own camera, model and HUD, and because every frame is replaced
+ * with the measured state instead of being re-simulated from recorded inputs, the drawn path
+ * cannot drift away from the measured one the way an open loop input replay would.
+ *
+ * The record is the little endian layout tools/export_trajectory.py writes, 64 bytes per frame.
+ */
+struct InjectRecord {
+    f32 pos[3];
+    f32 vel[3];
+    f32 forwardVel;
+    s32 faceAngle[3];
+    u32 action;
+    u32 actionState;
+    u32 actionTimer;
+    u32 actionArg;
+    s32 animID;
+    s32 animFrame;
+};
+
+static struct InjectRecord *sInjectRecords = NULL;
+static u32 sInjectCount = 0;
+static u32 sInjectStart = 0;
+static s32 sInjectChecked = FALSE;
+static s32 sInjectAnnounced = FALSE;
+
+/**
+ * Reads SM64_INJECT_FILE once, if it is set, and keeps the whole trajectory in memory.
+ *
+ * SM64_INJECT_START is the value of gGlobalTimer at which the first record applies, which is how
+ * a trajectory recorded in one room is lined up with a movie that walks the game to that room
+ * first. A malformed or missing file leaves injection off rather than failing the run, so the
+ * binary stays usable as an ordinary build.
+ */
+static void inject_load(void) {
+    char magic[8];
+    u32 header[2];
+    FILE *fp;
+    const char *start;
+    const char *path;
+
+    sInjectChecked = TRUE;
+    path = getenv("SM64_INJECT_FILE");
+    if (path == NULL) {
+        return;
+    }
+    start = getenv("SM64_INJECT_START");
+    if (start != NULL) {
+        sInjectStart = (u32) strtoul(start, NULL, 10);
+    }
+    fp = fopen(path, "rb");
+    if (fp == NULL) {
+        fprintf(stderr, "inject: cannot open %s\n", path);
+        return;
+    }
+    if (fread(magic, 1, sizeof(magic), fp) != sizeof(magic)
+        || memcmp(magic, "MBLJTRJ1", sizeof(magic)) != 0
+        || fread(header, sizeof(u32), 2, fp) != 2
+        || header[1] != sizeof(struct InjectRecord)) {
+        fprintf(stderr, "inject: %s is not a %u byte record trajectory\n", path,
+                (u32) sizeof(struct InjectRecord));
+        fclose(fp);
+        return;
+    }
+    sInjectRecords = malloc(header[0] * sizeof(struct InjectRecord));
+    if (sInjectRecords != NULL
+        && fread(sInjectRecords, sizeof(struct InjectRecord), header[0], fp) == header[0]) {
+        sInjectCount = header[0];
+        fprintf(stderr, "inject: %u frames from %s, starting at global timer %u\n", sInjectCount,
+                path, sInjectStart);
+    }
+    fclose(fp);
+}
+
+/**
+ * Stamps this frame's recorded state over Mario, leaving everything else the game decided alone.
+ *
+ * The call sits between Mario's action update and the copy into his object, so the object, the
+ * graphics node and the camera all read the recorded state. The action is only re-entered when it
+ * differs from the recorded one, which keeps set_mario_action's entry sounds and animation choice
+ * intact instead of restarting them every frame.
+ */
+static void inject_mario_state(void) {
+    const struct InjectRecord *record;
+    struct MarioState *m = gMarioState;
+    u32 index;
+
+    if (!sInjectChecked) {
+        inject_load();
+    }
+    if (sInjectCount == 0 || gGlobalTimer < sInjectStart) {
+        return;
+    }
+    index = gGlobalTimer - sInjectStart;
+    if (index >= sInjectCount) {
+        return;
+    }
+    record = &sInjectRecords[index];
+    if (!sInjectAnnounced) {
+        sInjectAnnounced = TRUE;
+        fprintf(stderr, "inject: first frame at global timer %u, y %.1f\n", gGlobalTimer,
+                (double) record->pos[1]);
+    }
+    if (m->action != record->action) {
+        set_mario_action(m, record->action, record->actionArg);
+    }
+    m->actionState = (u16) record->actionState;
+    m->actionTimer = (u16) record->actionTimer;
+    m->pos[0] = record->pos[0];
+    m->pos[1] = record->pos[1];
+    m->pos[2] = record->pos[2];
+    m->vel[0] = record->vel[0];
+    m->vel[1] = record->vel[1];
+    m->vel[2] = record->vel[2];
+    m->forwardVel = record->forwardVel;
+    m->faceAngle[0] = (s16) record->faceAngle[0];
+    m->faceAngle[1] = (s16) record->faceAngle[1];
+    m->faceAngle[2] = (s16) record->faceAngle[2];
+    m->marioObj->header.gfx.animInfo.animFrame = (s16) record->animFrame;
+    vec3f_copy(m->marioObj->header.gfx.pos, m->pos);
+    vec3s_set(m->marioObj->header.gfx.angle, 0, m->faceAngle[1], 0);
+}
+
