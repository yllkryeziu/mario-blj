+// Frame dump: set SM64_DUMP_DIR to a directory and every SM64_DUMP_EVERY'th
+// frame lands there as a binary PPM read straight off the GL back buffer.
+//
+// SM64_DUMP_FIRST and SM64_DUMP_LAST bound the range, because a full 8772 frame
+// TAS at 640x480 is 6 GB of PPM and a figure needs eighty frames of it. The file
+// name carries the buffer swap index rather than a count of what was written, so
+// it lines up with the frame column of a trace no matter what the bounds were.
+// SM64_DUMP_LAST also ends the process, so a dump of one sequence does not sit
+// waiting on a window nobody is watching.
+static void dump_frame_if_requested(void) {
+    static const char *dir = NULL;
+    static int every = 1, checked = 0, counter = 0;
+    static int first = 0, last = -1;
+    if (!checked) {
+        checked = 1;
+        dir = getenv("SM64_DUMP_DIR");
+        const char *e = getenv("SM64_DUMP_EVERY");
+        if (e) every = atoi(e) > 0 ? atoi(e) : 1;
+        const char *f = getenv("SM64_DUMP_FIRST");
+        if (f) first = atoi(f);
+        const char *l = getenv("SM64_DUMP_LAST");
+        if (l) last = atoi(l);
+    }
+    if (!dir) return;
+    const int frame = counter++;
+    if (last >= 0 && frame > last) {
+        exit(0);
+    }
+    if (frame < first) return;
+    if ((frame - first) % every) return;
+    int w, h;
+    SDL_GL_GetDrawableSize(wnd, &w, &h);
+    unsigned char *px = malloc((size_t) w * h * 3);
+    if (!px) return;
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, px);
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/frame_%06d.ppm", dir, frame);
+    FILE *f = fopen(path, "wb");
+    if (f) {
+        fprintf(f, "P6\n%d %d\n255\n", w, h);
+        for (int y = h - 1; y >= 0; y--) {
+            fwrite(px + (size_t) y * w * 3, 1, (size_t) w * 3, f);
+        }
+        fclose(f);
+    }
+    free(px);
+}
